+/* Polling and the RX worker are both consumers of the same queue. The
+   callback may yield, so claiming a packet without serializing consumers can
+   deliver it twice and advance rxout past rxin. Do not block a polling caller
+   (which can run during exception handling); let the active consumer finish. */
+static atomic_flag rx_processing = ATOMIC_FLAG_INIT;
+
+static bool bba_rx_process(void) {
+    bool consumed = false;
+
+    if(atomic_flag_test_and_set_explicit(&rx_processing, memory_order_acquire))
+        return false;
+
+    if(rxout != rxin) {
+        eth_rx_callback(rx_pkt[rxout].rxbuff + rx_pkt[rxout].offt,
+                        rx_pkt[rxout].pkt_size);
+        rxout = (rxout + 1) % MAX_PKTS;
+        consumed = true;
+    }
+
+    atomic_flag_clear_explicit(&rx_processing, memory_order_release);
+    return consumed;
 }
 

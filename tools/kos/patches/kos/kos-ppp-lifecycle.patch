@@ -123,7 +123,8 @@ int ppp_send(const uint8_t *data, size_t len, uint16_t proto) {
     fcs = (fcs >> 8) ^ fcstab[(fcs ^ ADDRESS_FIELD) & 0xFF];
     fcs = (fcs >> 8) ^ fcstab[(fcs ^ CONTROL_FIELD) & 0xFF];
 
-    ppp_state.device->tx(ppp_state.device, tmp, i, 0);
+    if(ppp_state.device->tx(ppp_state.device, tmp, i, 0) < 0)
+        goto tx_error;
 
     /* Next deal with the PPP protocol field. */
     i = 0;
@@ -147,19 +148,22 @@ int ppp_send(const uint8_t *data, size_t len, uint16_t proto) {
     fcs = (fcs >> 8) ^ fcstab[(fcs ^ ((uint8_t)(proto >> 8))) & 0xFF];
     fcs = (fcs >> 8) ^ fcstab[(fcs ^ ((uint8_t)proto)) & 0xFF];
 
-    ppp_state.device->tx(ppp_state.device, tmp, i, 0);
+    if(ppp_state.device->tx(ppp_state.device, tmp, i, 0) < 0)
+        goto tx_error;
 
     /* Deal with the data now. */
     for(j = 0; j < len; ++j) {
         if(check_accm_bit(ppp_state.out_accm, data[j])) {
             /* Send everything up to this point. */
-            if(run_len)
-                ppp_state.device->tx(ppp_state.device, run_start, run_len, 0);
+            if(run_len &&
+               ppp_state.device->tx(ppp_state.device, run_start, run_len, 0) < 0)
+                goto tx_error;
 
             /* Escape the current byte and send it. */
             tmp[0] = ESCAPE_CHAR;
             tmp[1] = data[j] ^ 0x20;
-            ppp_state.device->tx(ppp_state.device, tmp, 2, 0);
+            if(ppp_state.device->tx(ppp_state.device, tmp, 2, 0) < 0)
+                goto tx_error;
 
             /* Restart the run counter. */
             run_start = data + j + 1;
@@ -173,8 +177,9 @@ int ppp_send(const uint8_t *data, size_t len, uint16_t proto) {
     }
 
     /* Send anything left over. */
-    if(run_len)
-        ppp_state.device->tx(ppp_state.device, run_start, run_len, 0);
+    if(run_len &&
+       ppp_state.device->tx(ppp_state.device, run_start, run_len, 0) < 0)
+        goto tx_error;
 
     /* Finish up with the FCS and tack it onto the end along with an extra flag
        sequence to mark the end of the packet. */
@@ -199,12 +204,16 @@ int ppp_send(const uint8_t *data, size_t len, uint16_t proto) {
 
     tmp[i++] = FLAG_SEQUENCE;
 
-    ppp_state.device->tx(ppp_state.device, tmp, i, PPP_TX_END_OF_PKT);
+    if(ppp_state.device->tx(ppp_state.device, tmp, i, PPP_TX_END_OF_PKT) < 0)
+        goto tx_error;
 
     /* Clean up, we're done. */
     mutex_unlock(&mutex);
 
     return 0;
+tx_error:
+    mutex_unlock(&mutex);
+    return -1;
 }
 
 static int ppp_input(void) {
@@ -252,8 +261,12 @@ void *ppp_main(void *arg) {
     _ppp_enter_phase(PPP_PHASE_ESTABLISH);
 
     /* Loop as long as the link is open. */
-    while(ppp_state.phase != PPP_PHASE_DEAD) {
+    while(1) {
         mutex_lock(&mutex);
+        if(ppp_state.phase == PPP_PHASE_DEAD) {
+            mutex_unlock(&mutex);
+            break;
+        }
 
         /* Check if there's any data waiting for us on the device. */
         if(!(cur = data = ppp_state.device->rx(ppp_state.device, &data_len))) {
@@ -685,35 +698,63 @@ int ppp_init(void) {
 
 int ppp_shutdown(void) {
     ppp_protocol_t *i, *next;
+    kthread_t *worker;
 
-    /* If we're in an int, it's ok if we can't lock */
-    if(irq_inside_int())
-        mutex_trylock(&mutex);
-    else
-        mutex_lock(&mutex);
+    /* Joining the receive worker requires thread context. The caller must
+       serialize shutdown with ppp_init/ppp_connect. */
+    if(irq_inside_int()) {
+        errno = EWOULDBLOCK;
+        return -1;
+    }
+    mutex_lock(&mutex);
 
     if(!ppp_state.initted) {
         mutex_unlock(&mutex);
         return -1;
     }
 
-    /* Shut down any protocols that are still up. */
+    /* Stop RX before unregistering protocols or freeing device buffers. */
+    _ppp_enter_phase(PPP_PHASE_DEAD);
+    worker = ppp_state.thd;
+    ppp_state.thd = NULL;
+    mutex_unlock(&mutex);
+    if(worker)
+        thd_join(worker, NULL);
+    mutex_lock(&mutex);
+
+    if(ppp_state.device && ppp_state.device->shutdown)
+        ppp_state.device->shutdown(ppp_state.device);
+    ppp_state.device = NULL;
+
     i = TAILQ_FIRST(&protocols);
     while(i) {
         next = TAILQ_NEXT(i, entry);
-
         if(i->shutdown)
             i->shutdown(i);
         else
             ppp_del_protocol(i);
-
         i = next;
     }
 
-    /* XXXX: Do real cleanup... */
+    /* ISP credentials must not survive teardown in freed heap storage. */
+    if(ppp_state.username) {
+        volatile char *p = ppp_state.username;
+        for(size_t n = strlen(ppp_state.username); n; --n) *p++ = 0;
+    }
+    if(ppp_state.passwd) {
+        volatile char *p = ppp_state.passwd;
+        for(size_t n = strlen(ppp_state.passwd); n; --n) *p++ = 0;
+    }
+    free(ppp_state.username);
+    free(ppp_state.passwd);
+    ppp_state.username = ppp_state.passwd = NULL;
     ppp_state.initted = 0;
-
+    if(net_default_dev == &ppp_if)
+        net_set_default(NULL);
     net_unreg_device(&ppp_if);
+    memset(ppp_if.ip_addr, 0, sizeof(ppp_if.ip_addr));
+    memset(ppp_if.dns, 0, sizeof(ppp_if.dns));
+    ppp_recvbuf_len = 0;
 
     mutex_unlock(&mutex);
     return 0;
diff --git a/addons/libppp/ppp_modem.c b/addons/libppp/ppp_modem.c
index 3556321..8114190 100644
--- a/addons/libppp/ppp_modem.c
+++ b/addons/libppp/ppp_modem.c
@@ -6,9 +6,11 @@
 
 #include <stdio.h>
 #include <stdint.h>
+#include <errno.h>
 
 #include <kos/dbglog.h>
 #include <kos/thread.h>
+#include <kos/irq.h>
 
 #include <arch/timer.h>
 
@@ -35,13 +37,32 @@ static int ppp_modem_shutdown(ppp_device_t *self) {
 static int ppp_modem_tx(ppp_device_t *self, const uint8_t *data, size_t len,
                         uint32_t flags) {
     size_t done = 0;
+    uint64_t deadline = timer_ms_gettime64() + 5000;
     (void)self;
     (void)flags;
 
     /* As long as we have something to send, do so. */
     while(done < len) {
-        /* FIXME: This will loop infinitely if modem_write_data always fails */
-        done += modem_write_data((unsigned char *)data + done, (int)len - done);
+        if(!modem_is_connected()) {
+            errno = ENETDOWN;
+            return -1;
+        }
+        int written = modem_write_data((unsigned char *)data + done, (int)len - done);
+        if(written > 0) {
+            done += written;
+            deadline = timer_ms_gettime64() + 5000;
+        }
+        else if(timer_ms_gettime64() >= deadline) {
+            errno = ETIMEDOUT;
+            return -1;
+        }
+        else {
+            if(irq_inside_int()) {
+                errno = EWOULDBLOCK;
+                return -1;
+            }
+            thd_sleep(1);
+        }
     }
 
     return 0;

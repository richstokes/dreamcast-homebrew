diff --git a/kernel/arch/dreamcast/hardware/maple/vmu.c b/kernel/arch/dreamcast/hardware/maple/vmu.c
index 992c2a6..56f324b 100644
--- a/kernel/arch/dreamcast/hardware/maple/vmu.c
+++ b/kernel/arch/dreamcast/hardware/maple/vmu.c
@@ -479,6 +479,7 @@ int vmu_block_read(maple_device_t *dev, uint16_t blocknum, uint8_t *buffer) {
     if(genwait_wait(&dev->frame, "vmu_block_read", 100) < 0) {
         if(dev->frame.state != MAPLE_FRAME_RESPONDED) {
             /* It's probably never coming back, so just unlock the frame */
+            maple_queue_remove(&dev->frame);   /* or it stays queued for good */
             dev->frame.state = MAPLE_FRAME_VACANT;
             dbglog(DBG_ERROR, "vmu_block_read: timeout to unit %c%c, block %d\n",
                    dev->port + 'A', dev->unit + '0', (int)blocknum);
@@ -560,8 +561,11 @@ static int vmu_block_write_internal(maple_device_t *dev, uint16_t blocknum, cons
 
         /* Wait for the VMU to accept it */
         if(genwait_wait(&dev->frame, "vmu_block_write", 100) < 0) {
-            if(dev->frame.state != MAPLE_FRAME_UNSENT) {
+            /* The callback leaves an answered frame UNSENT; one still queued
+               was never answered, sent or not. */
+            if(dev->frame.state != MAPLE_FRAME_UNSENT || dev->frame.queued) {
                 /* It's probably never coming back, so just unlock the frame */
+                maple_queue_remove(&dev->frame);   /* or it stays queued for good */
                 dev->frame.state = MAPLE_FRAME_VACANT;
                 dbglog(DBG_ERROR, "vmu_block_write: timeout to unit %c%c, block %d\n",
                        dev->port + 'A', dev->unit + '0', (int)blocknum);
@@ -603,8 +607,9 @@ static int vmu_block_write_internal(maple_device_t *dev, uint16_t blocknum, cons
 
     /* Wait for the VMU to accept it */
     if(genwait_wait(&dev->frame, "vmu_block_write", 100) < 0) {
-        if(dev->frame.state != MAPLE_FRAME_UNSENT) {
+        if(dev->frame.state != MAPLE_FRAME_UNSENT || dev->frame.queued) {
             /* It's probably never coming back, so just unlock the frame */
+            maple_queue_remove(&dev->frame);   /* or it stays queued for good */
             dev->frame.state = MAPLE_FRAME_VACANT;
             dbglog(DBG_ERROR, "vmu_block_write: timeout to unit %c%c, block %d\n",
                    dev->port + 'A', dev->unit + '0', (int)blocknum);
@@ -677,6 +682,7 @@ int vmu_set_datetime(maple_device_t *dev, time_t unix) {
     if(genwait_wait(&dev->frame, "vmu_set_datetime", 500) < 0) {
         if(dev->frame.state != MAPLE_FRAME_VACANT)  {
             /* Something went wrong.... */
+            maple_queue_remove(&dev->frame);   /* or it stays queued for good */
             dev->frame.state = MAPLE_FRAME_VACANT;
             dbglog(DBG_ERROR, "vmu_set_datetime: timeout to unit %c%c\n",
                    dev->port + 'A', dev->unit + '0');
@@ -724,6 +730,7 @@ int vmu_get_datetime(maple_device_t *dev, time_t *unix) {
     if(genwait_wait(&dev->frame, "vmu_get_datetime", 10000) < 0) {
         if(dev->frame.state != MAPLE_FRAME_RESPONDED) {
             /* It's probably never coming back, so just unlock the frame */
+            maple_queue_remove(&dev->frame);   /* or it stays queued for good */
             dev->frame.state = MAPLE_FRAME_VACANT;
             dbglog(DBG_ERROR, "vmu_get_datetime: timeout to unit %c%c\n",
                    dev->port + 'A', dev->unit + '0');

diff --git a/core/input/keyboard_transition_queue.h b/core/input/keyboard_transition_queue.h
new file mode 100644
index 0000000..ab28118
--- /dev/null
+++ b/core/input/keyboard_transition_queue.h
@@ -0,0 +1,113 @@
+/* Preserve short host keyboard transitions until the guest actually polls.
+ * GPL-2.0-or-later, as part of Flycast. */
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <mutex>
+
+class KeyboardTransitionBuffer
+{
+public:
+	static constexpr std::size_t PortCount = 4;
+	static constexpr std::size_t Capacity = 256;
+
+	void push(int port, std::uint8_t modifiers, const std::uint8_t keys[6])
+	{
+		if (!validPort(port))
+			return;
+		State state;
+		state.modifiers = modifiers;
+		std::memcpy(state.keys.data(), keys, state.keys.size());
+		std::lock_guard<std::mutex> lock(mutex);
+		Channel& channel = channels[port];
+		channel.active = true;
+		if (state == channel.latest)
+			return;
+		channel.latest = state;
+		if (channel.count == Capacity)
+		{
+			// Discard an excessive backlog, but deliver a release before the
+			// current state so an overflow can never leave a guest key stuck.
+			channel.head = channel.count = 0;
+			append(channel, {});
+			if (state == State{})
+				return;
+		}
+		append(channel, state);
+	}
+
+	// Only the Maple GetCondition handler consumes a transition. A frame
+	// snapshot must not remove it: some guests skip keyboard polls for frames.
+	bool read(int port, std::uint8_t& modifiers, std::uint8_t keys[6])
+	{
+		if (!validPort(port))
+			return false;
+		std::lock_guard<std::mutex> lock(mutex);
+		Channel& channel = channels[port];
+		if (!channel.active)
+			return false;
+		if (channel.count != 0)
+		{
+			channel.delivered = channel.pending[channel.head];
+			channel.head = (channel.head + 1) % Capacity;
+			channel.count--;
+		}
+		modifiers = channel.delivered.modifiers;
+		std::memcpy(keys, channel.delivered.keys.data(), channel.delivered.keys.size());
+		return true;
+	}
+
+	void reset(int port)
+	{
+		if (!validPort(port))
+			return;
+		std::lock_guard<std::mutex> lock(mutex);
+		channels[port] = {};
+	}
+
+	void resetAll()
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		for (Channel& channel : channels)
+			channel = {};
+	}
+
+private:
+	struct State
+	{
+		std::uint8_t modifiers = 0;
+		std::array<std::uint8_t, 6> keys{};
+
+		bool operator==(const State& other) const
+		{
+			return modifiers == other.modifiers && keys == other.keys;
+		}
+	};
+
+	struct Channel
+	{
+		std::array<State, Capacity> pending{};
+		State latest{}, delivered{};
+		std::size_t head = 0, count = 0;
+		bool active = false;
+	};
+
+	static bool validPort(int port)
+	{
+		return port >= 0 && port < static_cast<int>(PortCount);
+	}
+
+	static void append(Channel& channel, const State& state)
+	{
+		channel.pending[(channel.head + channel.count) % Capacity] = state;
+		channel.count++;
+	}
+
+	std::mutex mutex;
+	std::array<Channel, PortCount> channels{};
+};
+
+inline KeyboardTransitionBuffer keyboardTransitionBuffer;

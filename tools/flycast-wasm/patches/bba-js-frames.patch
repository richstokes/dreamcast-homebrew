+    along with Flycast.  If not, see <https://www.gnu.org/licenses/>.
+ */
+// Broadband adapter for the WebAssembly build: browsers can't open sockets
+// and this build has no threads, so the page carries the BBA's Ethernet
+// frames. It defines globalThis.flycastNet with
+//   start(), stop(): when the guest starts and stops using the BBA
+//   send(frame): a Uint8Array the guest transmitted
+//   recv(): the next Uint8Array for the guest, or undefined
+// The modem is not supported.
+#pragma once
+#include "netservice.h"
+#include "hw/bba/bba.h"
+#include <emscripten.h>
+#include <vector>
+
+EM_JS(int, flycast_net_start, (), {
+	if (!globalThis.flycastNet)
+		return 0;
+	globalThis.flycastNet.start();
+	return 1;
+});
+
+EM_JS(void, flycast_net_stop, (), {
+	if (globalThis.flycastNet)
+		globalThis.flycastNet.stop();
+});
+
+EM_JS(void, flycast_net_send, (const u8 *frame, u32 size), {
+	if (globalThis.flycastNet)
+		globalThis.flycastNet.send(HEAPU8.slice(frame, frame + size));
+});
+
+// Copies the next frame for the guest into buf. Returns its size, or 0 when
+// none is waiting; a frame larger than max is dropped.
+EM_JS(u32, flycast_net_recv, (u8 *buf, u32 max), {
+	var frame = globalThis.flycastNet && globalThis.flycastNet.recv();
+	if (!frame || frame.length > max)
+		return 0;
+	HEAPU8.set(frame, buf);
+	return frame.length;
+});
+
+namespace net::modbba
+{
+
+class JsNetService : public Service
+{
+public:
+	bool start() override {
+		if (!started)
+			started = flycast_net_start();
+		return started;
+	}
+
+	void stop() override {
+		if (started)
+			flycast_net_stop();
+		started = false;
+		pending.clear();
+	}
+
+	void writeModem(u8 b) override {}
+	int readModem() override { return -1; }
+	int modemAvailable() override { return 0; }
+
+	void receiveEthFrame(const u8 *frame, u32 size) override {
+		flycast_net_send(frame, size);
+	}
+
+	void poll() override {
+		if (!started)
+			return;
+		for (;;)
+		{
+			if (pending.empty())
+			{
+				pending.resize(2048);
+				u32 size = flycast_net_recv(pending.data(), pending.size());
+				pending.resize(size);
+				if (size == 0)
+					return;
+			}
+			// The NIC refuses frames while its receive ring is full; keep
+			// this one for the next poll.
+			if (!bba_recv_frame(pending.data(), pending.size()))
+				return;
+			pending.clear();
+		}
+	}
+
+private:
+	bool started = false;
+	std::vector<u8> pending;
+};
+
+}
diff --git a/core/network/netservice.cpp b/core/network/netservice.cpp
index 889688b..aa72ce2 100644
--- a/core/network/netservice.cpp
+++ b/core/network/netservice.cpp
@@ -19,6 +19,9 @@
 #include "netservice.h"
 #include "picoppp.h"
 #include "dcnet.h"
+#ifdef __EMSCRIPTEN__
+#include "jsnet.h"
+#endif
 #include "emulator.h"
 #include "cfg/option.h"
 
@@ -33,10 +36,15 @@ bool start()
 	if (service == nullptr || usingDCNet != config::UseDCNet)
 	{
 		delete service;
+#ifdef __EMSCRIPTEN__
+		// Browsers can't open sockets, so the page carries the frames.
+		service = new JsNetService();
+#else
 		if (config::UseDCNet)
 			service = new DCNetService();
 		else
 			service = new PicoTcpService();
+#endif
 		usingDCNet = config::UseDCNet;
 	}
 	return service->start();
@@ -65,4 +73,9 @@ void receiveEthFrame(const u8 *frame, u32 size) {
 	service->receiveEthFrame(frame, size);
 }
 
+void poll() {
+	if (service != nullptr)
+		service->poll();
+}
+
 }

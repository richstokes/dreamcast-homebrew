    mov     #0, r4
    mov     r8, r5
    mov.l   .Lstrange_screen_width, r6
    mov     r8, r7
    add     #1, r7
    mov.l   .Lstrange_mask_rect, r0
    jsr     @r0
    nop
    add     #10, r8
    mov.l   .Lstrange_bar_bottom, r0
    cmp/hs  r0, r8
    bf      .Lstrange_scanline_loop
    nop
    mov.l   @r15+, r8
    lds.l   @r15+, pr
    rts
    nop

    .align 2
.Lstrange_mask_depth_ptr:.long quad_depth
.Lstrange_mask_color_ptr:.long quad_color
.Lstrange_mask_rect:     .long emit_rect
.Lstrange_bar_depth:     .long 0x3feccccd  ! 1.85 reciprocal-Z
.Lstrange_scan_depth:    .long 0x3fd33333  ! 1.65 reciprocal-Z
.Lstrange_bar_color:     .long 0xff000203
.Lstrange_scan_color:    .long 0xff000405
.Lstrange_screen_width:  .long 640
.Lstrange_screen_height: .long 480
.Lstrange_bar_bottom:    .long 422

! ---------------------------------------------------------------------------
! Ninety-six crossed shard triangles. A deterministic angular hash supplies
! size and radius; one scalar envelope detonates at frame 256, hangs through
! the close pass, and contracts during the copper coda.
! ---------------------------------------------------------------------------

draw_strange_shards:
    sts.l   pr, @-r15
    mov.l   r8, @-r15
    mov.l   r9, @-r15
    mov.l   r10, @-r15
    mov.l   r11, @-r15
    mov.l   r12, @-r15
    mov.l   r13, @-r15
    mov.l   r14, @-r15

    mov.l   .Lstrange_shard_palette, r10
    mov.l   .Lstrange_shard_hot_start, r0
    cmp/hs  r0, r9
    bf      .Lstrange_shard_grade_ready
    mov.l   .Lstrange_shard_copper_start, r0
    cmp/hs  r0, r9
    bt      .Lstrange_shard_grade_copper
    mov.l   .Lstrange_shard_palette_hot, r10
    bra     .Lstrange_shard_grade_ready
    nop
.Lstrange_shard_grade_copper:
    mov.l   .Lstrange_shard_palette_copper, r10
.Lstrange_shard_grade_ready:

    ! r13 = outward explosion in screen pixels.
    mov     #0, r13
    mov.l   .Lstrange_shard_start, r0
    cmp/hs  r0, r9
    bf      .Lstrange_shard_envelope_ready
    mov.l   .Lstrange_shard_peak, r0
    cmp/hs  r0, r9
    bt      .Lstrange_shard_after_peak
    mov     r9, r13
    mov.l   .Lstrange_shard_start, r0
    sub     r0, r13
    bra     .Lstrange_shard_envelope_ready
    nop
.Lstrange_shard_after_peak:
    mov.l   .Lstrange_shard_coda, r0
    cmp/hs  r0, r9
    bt      .Lstrange_shard_coda_env
    mov     r0, r13
    sub     r9, r13
    shlr    r13
    add     #32, r13
    bra     .Lstrange_shard_envelope_ready
    nop
.Lstrange_shard_coda_env:
    mov.l   .Lstrange_shard_end, r13
    sub     r9, r13
    cmp/pz  r13
    bt      .Lstrange_shard_coda_positive
    mov     #0, r13
.Lstrange_shard_coda_positive:
    shlr2   r13

.Lstrange_shard_envelope_ready:
    mov     #0, r12
.Lstrange_shard_loop:
    mov.l   .Lstrange_shard_angle_step, r0
    mulu.w  r12, r0
    sts     macl, r0
    mov     r9, r1
    shll2   r1
    shll2   r1
    shll2   r1                    ! frame * 64
    mov     r9, r2
    shll2   r2
    shll2   r2                    ! frame * 16
    add     r2, r1
    add     r2, r1                ! frame * 96
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0             ! radial sin/cos

    mov     #37, r0
    mulu.w  r12, r0
    sts     macl, r0
    and     #0x7f, r0
    add     #70, r0
    add     r13, r0
    lds     r0, fpul
    float   fpul, fr11            ! radial pixel distance
    fmov    fr1, fr2              ! radial dx
    fmov    fr0, fr3
    fneg    fr3
    mov.l   .Lstrange_shard_y_scale, r0
    fmov.s  @r0, fr10
    fmul    fr10, fr3             ! radial dy
    fmov    fr2, fr4
    fmul    fr11, fr4
    mov.l   .Lstrange_shard_cx, r0
    fmov.s  @r0, fr10
    fadd    fr10, fr4
    fmov    fr3, fr5
    fmul    fr11, fr5
    mov.l   .Lstrange_shard_cy, r0
    fmov.s  @r0, fr10
    fadd    fr10, fr5

    mov     #13, r0
    mulu.w  r12, r0
    sts     macl, r0
    and     #15, r0
    add     #10, r0
    mov     r13, r1
    shlr2   r1
    shlr2   r1
    add     r1, r0
    lds     r0, fpul
    float   fpul, fr6             ! shard length
    mov     r12, r0
    and     #3, r0
    add     #2, r0
    lds     r0, fpul
    float   fpul, fr7             ! shard half-width
    fmov    fr3, fr8
    fneg    fr8                    ! tangent X
    fmov    fr2, fr9               ! tangent Y
    mov.l   .Lstrange_shard_depth, r0
    fmov.s  @r0, fr10
    mov     r12, r0
    and     #3, r0
    shll2   r0
    mov     r10, r1
    add     r0, r1
    mov.l   @r1, r14

    ! Radial needle triangle: tangent base, outward tip.
    fmov    fr8, fr12
    fmul    fr7, fr12
    fadd    fr4, fr12
    fmov    fr9, fr13
    fmul    fr7, fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_normal, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop
    fmov    fr8, fr12
    fmul    fr7, fr12
    fneg    fr12
    fadd    fr4, fr12
    fmov    fr9, fr13
    fmul    fr7, fr13
    fneg    fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_normal, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop
    fmov    fr2, fr12
    fmul    fr6, fr12
    fadd    fr4, fr12
    fmov    fr3, fr13
    fmul    fr6, fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_eol, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop

    ! Cross blade: radial base, shorter tangent tip.
    fmov    fr2, fr12
    fmul    fr7, fr12
    fadd    fr4, fr12
    fmov    fr3, fr13
    fmul    fr7, fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_normal, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop
    fmov    fr2, fr12
    fmul    fr7, fr12
    fneg    fr12
    fadd    fr4, fr12
    fmov    fr3, fr13
    fmul    fr7, fr13
    fneg    fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_normal, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_shard_cross_scale, r0
    fmov.s  @r0, fr11
    fmul    fr6, fr11
    fmov    fr8, fr12
    fmul    fr11, fr12
    fadd    fr4, fr12
    fmov    fr9, fr13
    fmul    fr11, fr13
    fadd    fr5, fr13
    fmov    fr10, fr14
    mov.l   .Lstrange_shard_eol, r4
    mov     r14, r5
    mov.l   .Lstrange_shard_emit, r0
    jsr     @r0
    nop

    add     #1, r12
    mov     #96, r0
    cmp/hs  r0, r12
    bt      .Lstrange_shard_done
    bra     .Lstrange_shard_loop
    nop

.Lstrange_shard_done:
    mov.l   @r15+, r14
    mov.l   @r15+, r13
    mov.l   @r15+, r12
    mov.l   @r15+, r11
    mov.l   @r15+, r10
    mov.l   @r15+, r9
    mov.l   @r15+, r8
    lds.l   @r15+, pr
    rts
    nop

    .align 2
.Lstrange_shard_start:      .long 256
.Lstrange_shard_peak:       .long 384
.Lstrange_shard_coda:       .long 576
.Lstrange_shard_end:        .long 736
.Lstrange_shard_angle_step: .long 683
.Lstrange_shard_cx:         .long center_x
.Lstrange_shard_cy:         .long center_y
.Lstrange_shard_y_scale:    .long strange_shard_y_scale
.Lstrange_shard_depth:      .long strange_shard_depth
.Lstrange_shard_cross_scale:.long strange_shard_cross_scale
.Lstrange_shard_palette:    .long strange_shard_palette
.Lstrange_shard_palette_hot:.long strange_shard_palette_hot
.Lstrange_shard_palette_copper:.long strange_shard_palette_copper
.Lstrange_shard_emit:       .long emit_vertex
.Lstrange_shard_normal:     .long CMD_VERTEX
.Lstrange_shard_eol:        .long CMD_VERTEX_EOL
.Lstrange_shard_hot_start:   .long 240
.Lstrange_shard_copper_start:.long 576

! ---------------------------------------------------------------------------
! Sixty-four deterministic outward streaks. Each endpoint pair is written to
! a two-element scratch cache and expanded by the same robust beam primitive.
! ---------------------------------------------------------------------------

draw_strange_streaks:
    sts.l   pr, @-r15
    mov.l   r8, @-r15
    mov.l   r9, @-r15
    mov.l   r10, @-r15
    mov.l   r11, @-r15
    mov.l   r12, @-r15
    mov.l   r13, @-r15
    mov.l   r14, @-r15
    mov.l   .Lstrange_streak_palette, r10
    mov.l   .Lstrange_streak_hot_start, r0
    cmp/hs  r0, r9
    bf      .Lstrange_streak_grade_ready
    mov.l   .Lstrange_streak_copper_start, r0
    cmp/hs  r0, r9
    bt      .Lstrange_streak_grade_copper
    mov.l   .Lstrange_streak_palette_hot, r10
    bra     .Lstrange_streak_grade_ready
    nop
.Lstrange_streak_grade_copper:
    mov.l   .Lstrange_streak_palette_copper, r10
.Lstrange_streak_grade_ready:
    mov     #0, r12
.Lstrange_streak_loop:
    mov     r12, r0
    shll8   r0
    shll2   r0                    ! angle index * 1024
    mov     r9, r1
    shll8   r1
    shlr    r1                    ! frame * 128
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0

    mov     #53, r0
    mulu.w  r12, r0
    sts     macl, r0
    mov     r9, r1
    shll2   r1
    add     r1, r0
    extu.b  r0, r0
    add     #80, r0
    lds     r0, fpul
    float   fpul, fr2             ! start radius
    mov     r12, r0
    and     #31, r0
    add     #32, r0
    lds     r0, fpul
    float   fpul, fr3
    fadd    fr2, fr3              ! end radius
    mov.l   .Lstrange_streak_y_scale, r0
    fmov.s  @r0, fr4
    mov.l   .Lstrange_streak_cx, r0
    fmov.s  @r0, fr5
    mov.l   .Lstrange_streak_cy, r0
    fmov.s  @r0, fr6
    mov.l   .Lstrange_streak_temp, r8
    fmov    fr1, fr7
    fmul    fr2, fr7
    fadd    fr5, fr7
    fmov.s  fr7, @r8
    add     #4, r8
    fmov    fr0, fr7
    fneg    fr7
    fmul    fr4, fr7
    fmul    fr2, fr7
    fadd    fr6, fr7
    fmov.s  fr7, @r8
    add     #4, r8
    mov.l   .Lstrange_streak_depth, r0
    fmov.s  @r0, fr7
    fmov.s  fr7, @r8
    add     #4, r8
    fmov    fr1, fr7
    fmul    fr3, fr7
    fadd    fr5, fr7
    fmov.s  fr7, @r8
    add     #4, r8
    fmov    fr0, fr7
    fneg    fr7
    fmul    fr4, fr7
    fmul    fr3, fr7
    fadd    fr6, fr7
    fmov.s  fr7, @r8
    add     #4, r8
    mov.l   .Lstrange_streak_depth, r0
    fmov.s  @r0, fr7
    fmov.s  fr7, @r8

    mov     r12, r0
    and     #3, r0
    shll2   r0
    mov     r10, r1
    add     r0, r1
    mov.l   @r1, r7
    mov.l   .Lstrange_streak_temp, r4
    mov     r4, r5
    add     #12, r5
    mov.l   .Lstrange_streak_width, r6
    bsr     strange_emit_beam
    nop
    add     #1, r12
    mov     #64, r0
    cmp/hs  r0, r12
    bf      .Lstrange_streak_loop
    nop
    mov.l   @r15+, r14
    mov.l   @r15+, r13
    mov.l   @r15+, r12
    mov.l   @r15+, r11
    mov.l   @r15+, r10
    mov.l   @r15+, r9
    mov.l   @r15+, r8
    lds.l   @r15+, pr
    rts
    nop

    .align 2
.Lstrange_streak_temp:   .long strange_temp_edge
.Lstrange_streak_width:  .long strange_streak_width
.Lstrange_streak_depth:  .long strange_streak_depth
.Lstrange_streak_y_scale:.long strange_streak_y_scale
.Lstrange_streak_cx:     .long center_x
.Lstrange_streak_cy:     .long center_y
.Lstrange_streak_palette:.long strange_streak_palette
.Lstrange_streak_palette_hot:.long strange_streak_palette_hot
.Lstrange_streak_palette_copper:.long strange_streak_palette_copper
.Lstrange_streak_hot_start:   .long 240
.Lstrange_streak_copper_start:.long 576


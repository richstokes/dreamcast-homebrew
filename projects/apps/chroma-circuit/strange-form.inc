! ---------------------------------------------------------------------------
! Camera projection into a 12-byte cache element.
! Inputs: fr7/fr8/fr9 = world XYZ, r4 = destination.
! Output: [r4] = screen X, screen Y, reciprocal camera Z.
! ---------------------------------------------------------------------------

strange_project_point:
    mov     r4, r6
    mov.l   .Lstrange_project_position, r0
    fmov.s  @r0, fr0
    fsub    fr0, fr7
    add     #4, r0
    fmov.s  @r0, fr0
    fsub    fr0, fr8
    add     #4, r0
    fmov.s  @r0, fr0
    fsub    fr0, fr9

    mov.l   .Lstrange_project_yaw, r0
    fmov.s  @r0, fr0
    add     #4, r0
    fmov.s  @r0, fr1
    mov.l   .Lstrange_project_pitch, r0
    fmov.s  @r0, fr2
    add     #4, r0
    fmov.s  @r0, fr3
    mov.l   .Lstrange_project_roll, r0
    fmov.s  @r0, fr4
    add     #4, r0
    fmov.s  @r0, fr5

    fmov    fr7, fr10
    fmul    fr1, fr10
    fmov    fr9, fr11
    fmul    fr0, fr11
    fsub    fr11, fr10             ! yawed X
    fmov    fr7, fr11
    fmul    fr0, fr11
    fneg    fr11
    fmov    fr9, fr12
    fmul    fr1, fr12
    fsub    fr12, fr11             ! yawed forward Z

    fmov    fr8, fr12
    fmul    fr3, fr12
    fmov    fr11, fr13
    fmul    fr2, fr13
    fadd    fr13, fr12             ! pitched Y
    fmov    fr8, fr13
    fmul    fr2, fr13
    fneg    fr13
    fmov    fr11, fr14
    fmul    fr3, fr14
    fadd    fr14, fr13             ! positive camera Z

    fmov    fr10, fr14
    fmul    fr5, fr14
    fmov    fr12, fr15
    fmul    fr4, fr15
    fadd    fr15, fr14             ! rolled X
    fmov    fr10, fr15
    fmul    fr4, fr15
    fneg    fr15
    fmov    fr12, fr7
    fmul    fr5, fr7
    fadd    fr7, fr15              ! rolled Y

    mov.l   .Lstrange_project_one, r0
    fmov.s  @r0, fr9
    fdiv    fr13, fr9
    mov.l   .Lstrange_project_scale, r0
    fmov.s  @r0, fr8
    fmul    fr8, fr14
    fmul    fr9, fr14
    mov.l   .Lstrange_project_cx, r0
    fmov.s  @r0, fr8
    fadd    fr8, fr14
    mov.l   .Lstrange_project_scale, r0
    fmov.s  @r0, fr8
    fmul    fr8, fr15
    fmul    fr9, fr15
    fneg    fr15
    mov.l   .Lstrange_project_cy, r0
    fmov.s  @r0, fr8
    fadd    fr8, fr15
    fmov.s  fr14, @r6
    add     #4, r6
    fmov.s  fr15, @r6
    add     #4, r6
    fmov.s  fr9, @r6
    rts
    nop

    .align 2
.Lstrange_project_position:.long camera_position
.Lstrange_project_yaw:     .long camera_yaw
.Lstrange_project_pitch:   .long camera_pitch
.Lstrange_project_roll:    .long camera_roll

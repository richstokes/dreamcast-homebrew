! ---------------------------------------------------------------------------
! CHROMA CIRCUIT -- Scene 05: STRANGE FORM
!
! An original Dreamcast-native scene inspired by the visual grammar of
! Conspiracy's 2006 Chaos Theory: crushed cinematic framing, cold mechanical
! rings, overexposed radial filaments, fractured silhouettes, and a camera
! that changes from a measured reveal into an aggressive banked flyby.
!
! No source data or assets from the production are used. Six analytic annular
! mechanisms, twenty curved filaments, ninety-six procedural shard crosses,
! and sixty-four speed streaks are regenerated by SH-4 every frame. Projected
! ring and filament coordinates are cached once and then shared by the solid
! and luminous passes.
!
! Fixed effect budget (not counting the shared vector title/transition):
!   288  opaque annular-panel triangles
!    16  dark-core triangles
!   576  ring-rim beam triangles
!   480  filament beam triangles
!   192  crossed-shard triangles
!   128  speed-streak triangles
!    16  additive core-flare triangles
!    74  scanline-mask triangles
!     4  letterbox triangles
!     2  backdrop triangles
!  ----
!  1776  triangles, about 3,700 native vertex blocks before the shared HUD
! ---------------------------------------------------------------------------

    .section .text,"ax"
    .align 2

! r9 is the private scene frame, 0..767. Preserve it so the common transition
! sees the same local time after this routine returns.
draw_scene_strange_form:
    sts.l   pr, @-r15
    mov.l   r8, @-r15
    mov.l   r9, @-r15
    mov.l   r10, @-r15
    mov.l   r11, @-r15
    mov.l   r12, @-r15
    mov.l   r13, @-r15
    mov.l   r14, @-r15

    mov.l   .Lstrange_scene_camera, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_ring_build, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_filament_build, r0
    jsr     @r0
    nop

    ! Solid pass: a steel-green field, gapped annular machinery, and a dark
    ! central lens. The near letterbox/scanline mask is emitted last so every
    ! additive primitive remains behind it; draw_title then sits above it.
    mov.l   .Lstrange_scene_opaque, r4
    mov.l   .Lstrange_scene_submit, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_backdrop, r8
    mov     #4, r10
.Lstrange_backdrop_loop:
    mov     r8, r4
    mov.l   .Lstrange_scene_submit, r0
    jsr     @r0
    nop
    add     #32, r8
    dt      r10
    bf      .Lstrange_backdrop_loop
    nop

    mov.l   .Lstrange_scene_panels, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_core_disc, r0
    mov.l   .Lstrange_scene_core_radius, r4
    mov.l   .Lstrange_scene_core_palette, r5
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_masks, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_title, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_zero, r4
    mov.l   .Lstrange_scene_submit, r0
    jsr     @r0
    nop

    ! ONE/ONE geometry supplies the bloom vocabulary without a texture or a
    ! framebuffer post-process. Low component values intentionally converge
    ! to white only where the mechanical layers meet.
    mov.l   .Lstrange_scene_additive, r4
    mov.l   .Lstrange_scene_submit, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_rims, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_filaments, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_shards, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_streaks, r0
    jsr     @r0
    nop
    mov.l   .Lstrange_scene_flare, r0
    jsr     @r0
    nop

    mov.l   @r15+, r14
    mov.l   @r15+, r13
    mov.l   @r15+, r12
    mov.l   @r15+, r11
    mov.l   @r15+, r10
    mov.l   @r15+, r9
    mov.l   @r15+, r8
    lds.l   @r15+, pr
    rts
    nop

    .align 2
.Lstrange_scene_camera:        .long update_strange_camera
.Lstrange_scene_ring_build:    .long build_strange_ring_cache
.Lstrange_scene_filament_build:.long build_strange_filament_cache
.Lstrange_scene_panels:        .long draw_strange_ring_panels
.Lstrange_scene_rims:          .long draw_strange_ring_rims
.Lstrange_scene_filaments:     .long draw_strange_filaments
.Lstrange_scene_shards:        .long draw_strange_shards
.Lstrange_scene_streaks:       .long draw_strange_streaks
.Lstrange_scene_core_disc:     .long draw_strange_disc
.Lstrange_scene_flare:         .long draw_strange_flare
.Lstrange_scene_masks:         .long draw_strange_masks
.Lstrange_scene_submit:        .long ta_submit
.Lstrange_scene_title:         .long draw_title
.Lstrange_scene_opaque:        .long opaque_header
.Lstrange_scene_additive:      .long additive_header
.Lstrange_scene_zero:          .long zero_block
.Lstrange_scene_backdrop:      .long strange_backdrop_vertices
.Lstrange_scene_core_radius:   .long strange_core_radius
.Lstrange_scene_core_palette:  .long strange_core_palette

! ---------------------------------------------------------------------------
! Dedicated camera. A 160-frame approach moves from radius 8.4 to 5.1, then a
! 208-unit yaw rail, +/-16.9-degree pitch, and +/-33.75-degree bank skim the
! outer radial structures. The 4.8 minimum radius remains outside the 3.9-unit
! filament envelope, preserving positive camera-space Z without a clip branch.
! ---------------------------------------------------------------------------

update_strange_camera:
    ! yaw = 0x1800 + frame * 208 (256 - 32 - 16)
    mov     r9, r0
    shll8   r0
    mov     r9, r1
    shll2   r1
    shll2   r1
    shll    r1
    sub     r1, r0
    mov     r9, r1
    shll2   r1
    shll2   r1
    sub     r1, r0
    mov.l   .Lstrange_cam_yaw_bias, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0
    mov.l   .Lstrange_cam_yaw, r0
    fmov.s  fr0, @r0
    add     #4, r0
    fmov.s  fr1, @r0

    ! A slow pitch wave and its quadrature drive the aggressive roll.
    mov     r9, r0
    shll8   r0
    shlr2   r0                    ! frame * 64
    mov     r9, r1
    shll2   r1
    shll2   r1                    ! frame * 16
    add     r1, r0                ! frame * 80
    lds     r0, fpul
    fsca    fpul, dr2

    fmov    fr2, fr10
    mov.l   .Lstrange_cam_pitch_units, r0
    fmov.s  @r0, fr11
    fmul    fr11, fr10
    ftrc    fr10, fpul
    sts     fpul, r0
    lds     r0, fpul
    fsca    fpul, dr4
    mov.l   .Lstrange_cam_pitch, r0
    fmov.s  fr4, @r0
    add     #4, r0
    fmov.s  fr5, @r0

    fmov    fr3, fr10
    mov.l   .Lstrange_cam_roll_units, r0
    fmov.s  @r0, fr11
    fmul    fr11, fr10
    ftrc    fr10, fpul
    sts     fpul, r0
    lds     r0, fpul
    fsca    fpul, dr6
    mov.l   .Lstrange_cam_roll, r0
    fmov.s  fr6, @r0
    add     #4, r0
    fmov.s  fr7, @r0

    ! Opening hold, linear fly-in, then a restrained radial breath.
    mov     r9, r0
    mov     #96, r1
    cmp/hs  r1, r0
    bt      .Lstrange_camera_after_hold
    mov.l   .Lstrange_cam_radius_far, r0
    fmov.s  @r0, fr9
    bra     .Lstrange_camera_radius_ready
    nop
.Lstrange_camera_after_hold:
    mov.l   .Lstrange_cam_fly_end, r1
    cmp/hs  r1, r0
    bt      .Lstrange_camera_close
    add     #-96, r0
    lds     r0, fpul
    float   fpul, fr10
    mov.l   .Lstrange_cam_fly_step, r0
    fmov.s  @r0, fr11
    fmul    fr11, fr10
    mov.l   .Lstrange_cam_radius_far, r0
    fmov.s  @r0, fr9
    fsub    fr10, fr9
    bra     .Lstrange_camera_radius_ready
    nop
.Lstrange_camera_close:
    mov     r9, r0
    shll8   r0
    shlr    r0                    ! frame * 128
    lds     r0, fpul
    fsca    fpul, dr8
    mov.l   .Lstrange_cam_radius_amp, r0
    fmov.s  @r0, fr10
    fmul    fr9, fr10
    mov.l   .Lstrange_cam_radius_close, r0
    fmov.s  @r0, fr9
    fadd    fr10, fr9

.Lstrange_camera_radius_ready:
    ! Position on the same analytic sphere consumed by strange_project_point.
    fmov    fr9, fr10
    fmul    fr5, fr10
    fmov    fr10, fr11
    fmul    fr0, fr11              ! X = R*cp*sin(yaw)
    fmov    fr9, fr12
    fmul    fr4, fr12              ! Y = R*sin(pitch)
    fmov    fr10, fr13
    fmul    fr1, fr13              ! Z = R*cp*cos(yaw)
    mov.l   .Lstrange_cam_position, r0
    fmov.s  fr11, @r0
    add     #4, r0
    fmov.s  fr12, @r0
    add     #4, r0
    fmov.s  fr13, @r0
    rts
    nop

    .align 2
.Lstrange_cam_yaw_bias:    .long 0x00001800
.Lstrange_cam_fly_end:     .long 256
.Lstrange_cam_yaw:         .long camera_yaw
.Lstrange_cam_pitch:       .long camera_pitch
.Lstrange_cam_roll:        .long camera_roll
.Lstrange_cam_position:    .long camera_position
.Lstrange_cam_pitch_units: .long strange_camera_pitch_units
.Lstrange_cam_roll_units:  .long strange_camera_roll_units
.Lstrange_cam_radius_far:  .long strange_camera_radius_far
.Lstrange_cam_radius_close:.long strange_camera_radius_close
.Lstrange_cam_radius_amp:  .long strange_camera_radius_amplitude
.Lstrange_cam_fly_step:    .long strange_camera_fly_step

! ---------------------------------------------------------------------------
! Ring cache. Each ring owns 33 seam-closed angular samples; every sample is an
! outer and inner projected point (screen X, screen Y, reciprocal Z). Rings
! rotate around two independent axes and slide along their own plane normals.
! ---------------------------------------------------------------------------

build_strange_ring_cache:
    sts.l   pr, @-r15
    mov.l   r8, @-r15
    mov.l   r9, @-r15
    mov.l   r10, @-r15
    mov.l   r11, @-r15
    mov.l   r12, @-r15
    mov.l   r13, @-r15
    mov.l   r14, @-r15

    mov.l   .Lstrange_ring_cache_ptr, r8
    mov.l   .Lstrange_ring_offsets, r13
    mov.l   .Lstrange_ring_radii, r14
    mov     #0, r12               ! ring index

.Lstrange_ring_build_ring:
    ! X tilt = frame*48 + ring*8192.
    mov     r9, r0
    shll2   r0
    shll2   r0
    shll    r0                    ! *32
    mov     r9, r1
    shll2   r1
    shll2   r1                    ! *16
    add     r1, r0
    mov     r12, r1
    shll8   r1
    shll2   r1
    shll2   r1
    shll    r1                    ! ring * 8192
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0
    mov.l   .Lstrange_basis_sinx, r0
    fmov.s  fr0, @r0
    mov.l   .Lstrange_basis_cosx, r0
    fmov.s  fr1, @r0

    ! Y tilt = -frame*40 + ring*10923.
    mov     r9, r0
    shll2   r0
    shll2   r0
    shll    r0                    ! frame * 32
    mov     r9, r1
    shll2   r1
    shll    r1                    ! frame * 8
    add     r1, r0
    neg     r0, r0
    mov.l   .Lstrange_ring_y_step, r1
    mulu.w  r12, r1
    sts     macl, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr2
    mov.l   .Lstrange_basis_siny, r0
    fmov.s  fr2, @r0
    mov.l   .Lstrange_basis_cosy, r0
    fmov.s  fr3, @r0

    ! Axial offset = ring base + 0.10*sin(frame*96 + ring*7000).
    mov     r9, r0
    shll2   r0
    shll2   r0
    shll2   r0                    ! *64
    mov     r9, r1
    shll2   r1
    shll2   r1
    shll    r1                    ! *32
    add     r1, r0
    mov.l   .Lstrange_ring_slide_step, r1
    mulu.w  r12, r1
    sts     macl, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr4
    mov.l   .Lstrange_slide_amplitude, r0
    fmov.s  @r0, fr6
    fmul    fr4, fr6
    fmov.s  @r13+, fr7
    fadd    fr7, fr6              ! scalar plane-normal displacement

    ! Plane normal after X then Y rotation: (sy*cx, -sx, cy*cx).
    mov.l   .Lstrange_basis_cosx, r0
    fmov.s  @r0, fr7
    fmov    fr2, fr8
    fmul    fr7, fr8
    fmul    fr6, fr8
    mov.l   .Lstrange_center_x, r0
    fmov.s  fr8, @r0
    fmov    fr0, fr8
    fneg    fr8
    fmul    fr6, fr8
    mov.l   .Lstrange_center_y, r0
    fmov.s  fr8, @r0
    fmov    fr3, fr8
    fmul    fr7, fr8
    fmul    fr6, fr8
    mov.l   .Lstrange_center_z, r0
    fmov.s  fr8, @r0

    ! Per-ring radius pulse, then derive the 0.14-wide inner radius.
    mov     r9, r0
    shll8   r0
    shlr    r0                    ! frame * 128
    mov.l   .Lstrange_ring_pulse_step, r1
    mulu.w  r12, r1
    sts     macl, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr4
    fmov.s  @r14+, fr6
    mov.l   .Lstrange_ring_pulse_amp, r0
    fmov.s  @r0, fr7
    fmul    fr4, fr7
    fadd    fr7, fr6
    mov.l   .Lstrange_outer_radius, r0
    fmov.s  fr6, @r0
    mov.l   .Lstrange_ring_width, r0
    fmov.s  @r0, fr7
    fsub    fr7, fr6
    mov.l   .Lstrange_inner_radius, r0
    fmov.s  fr6, @r0

    mov     #0, r11               ! seam-inclusive point index 0..32
.Lstrange_ring_build_point:
    ! theta = point*2048 + frame*64 + ring*3072.
    mov     r11, r0
    shll8   r0
    shll2   r0
    shll    r0
    mov     r9, r1
    shll8   r1
    shlr2   r1
    add     r1, r0
    mov.l   .Lstrange_ring_spin_step, r1
    mulu.w  r12, r1
    sts     macl, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0              ! sin theta, cos theta

    mov.l   .Lstrange_outer_radius, r0
    fmov.s  @r0, fr2
    fmov    fr1, fr3
    fmul    fr2, fr3               ! base X
    fmov    fr0, fr4
    fmul    fr2, fr4               ! base Y
    mov.l   .Lstrange_basis_sinx, r0
    fmov.s  @r0, fr5
    mov.l   .Lstrange_basis_cosx, r0
    fmov.s  @r0, fr6
    mov.l   .Lstrange_basis_siny, r0
    fmov.s  @r0, fr10
    mov.l   .Lstrange_basis_cosy, r0
    fmov.s  @r0, fr11

    ! Outer point after X/Y basis rotation.
    fmov    fr3, fr7
    fmul    fr11, fr7
    fmov    fr4, fr12
    fmul    fr5, fr12
    fmul    fr10, fr12
    fadd    fr12, fr7
    fmov    fr4, fr8
    fmul    fr6, fr8
    fmov    fr3, fr9
    fmul    fr10, fr9
    fneg    fr9
    fmov    fr4, fr12
    fmul    fr5, fr12
    fmul    fr11, fr12
    fadd    fr12, fr9
    mov.l   .Lstrange_center_x, r0
    fmov.s  @r0, fr12
    fadd    fr12, fr7
    mov.l   .Lstrange_center_y, r0
    fmov.s  @r0, fr12
    fadd    fr12, fr8
    mov.l   .Lstrange_center_z, r0
    fmov.s  @r0, fr12
    fadd    fr12, fr9

    ! Build the inner world point before projection clobbers the FPU bank.
    mov.l   .Lstrange_inner_radius, r0
    fmov.s  @r0, fr2
    fmov    fr1, fr12
    fmul    fr2, fr12              ! inner base X
    fmov    fr0, fr13
    fmul    fr2, fr13              ! inner base Y

    fmov    fr12, fr14
    fmul    fr11, fr14
    fmov    fr13, fr15
    fmul    fr5, fr15
    fmul    fr10, fr15
    fadd    fr15, fr14
    mov.l   .Lstrange_center_x, r0
    fmov.s  @r0, fr15
    fadd    fr15, fr14
    mov.l   .Lstrange_inner_xyz, r0
    fmov.s  fr14, @r0

    fmov    fr13, fr14
    fmul    fr6, fr14
    mov.l   .Lstrange_center_y, r0
    fmov.s  @r0, fr15
    fadd    fr15, fr14
    mov.l   .Lstrange_inner_xyz, r0
    add     #4, r0
    fmov.s  fr14, @r0

    fmov    fr12, fr14
    fmul    fr10, fr14
    fneg    fr14
    fmov    fr13, fr15
    fmul    fr5, fr15
    fmul    fr11, fr15
    fadd    fr15, fr14
    mov.l   .Lstrange_center_z, r0
    fmov.s  @r0, fr15
    fadd    fr15, fr14
    mov.l   .Lstrange_inner_xyz, r0
    add     #8, r0
    fmov.s  fr14, @r0

    mov     r8, r4
    mov.l   .Lstrange_ring_project, r0
    jsr     @r0
    nop
    add     #12, r8
    mov.l   .Lstrange_inner_xyz, r0
    fmov.s  @r0, fr7
    add     #4, r0
    fmov.s  @r0, fr8
    add     #4, r0
    fmov.s  @r0, fr9
    mov     r8, r4
    mov.l   .Lstrange_ring_project, r0
    jsr     @r0
    nop
    add     #12, r8

    add     #1, r11
    mov     #33, r0
    cmp/hs  r0, r11
    bf      .Lstrange_ring_build_point
    nop
    add     #1, r12
    mov     #6, r0
    cmp/hs  r0, r12
    bt      .Lstrange_ring_build_done
    bra     .Lstrange_ring_build_ring
    nop

.Lstrange_ring_build_done:
    ! Cache the projected origin for the dark lens and additive flare.
    fldi0   fr7
    fldi0   fr8
    fldi0   fr9
    mov.l   .Lstrange_core_projected, r4
    mov.l   .Lstrange_ring_project, r0
    jsr     @r0
    nop

    mov.l   @r15+, r14
    mov.l   @r15+, r13
    mov.l   @r15+, r12
    mov.l   @r15+, r11
    mov.l   @r15+, r10
    mov.l   @r15+, r9
    mov.l   @r15+, r8
    lds.l   @r15+, pr
    rts
    nop

    .align 2
.Lstrange_ring_cache_ptr: .long strange_ring_projected
.Lstrange_ring_offsets:   .long strange_ring_base_offsets
.Lstrange_ring_radii:     .long strange_ring_base_radii
.Lstrange_ring_y_step:    .long 10923
.Lstrange_ring_slide_step:.long 7000
.Lstrange_ring_pulse_step:.long 5000
.Lstrange_ring_spin_step: .long 3072
.Lstrange_slide_amplitude:.long strange_ring_slide_amplitude
.Lstrange_ring_pulse_amp: .long strange_ring_pulse_amplitude
.Lstrange_ring_width:     .long strange_ring_width
.Lstrange_basis_sinx:     .long strange_basis_sinx
.Lstrange_basis_cosx:     .long strange_basis_cosx
.Lstrange_basis_siny:     .long strange_basis_siny
.Lstrange_basis_cosy:     .long strange_basis_cosy
.Lstrange_center_x:       .long strange_ring_center_x
.Lstrange_center_y:       .long strange_ring_center_y
.Lstrange_center_z:       .long strange_ring_center_z
.Lstrange_outer_radius:   .long strange_outer_radius
.Lstrange_inner_radius:   .long strange_inner_radius
.Lstrange_inner_xyz:      .long strange_inner_xyz
.Lstrange_core_projected: .long strange_core_projected
.Lstrange_ring_project:   .long strange_project_point

! ---------------------------------------------------------------------------
! Twenty radial splines. Their radius grows from the lens to the outer shell,
! while angle advances along each strand and Z crosses the device. The result
! reads as curved cables being pulled through the ring mechanism.
! ---------------------------------------------------------------------------

build_strange_filament_cache:
    sts.l   pr, @-r15
    mov.l   r8, @-r15
    mov.l   r9, @-r15
    mov.l   r10, @-r15
    mov.l   r11, @-r15
    mov.l   r12, @-r15
    mov.l   r13, @-r15
    mov.l   r14, @-r15

    mov.l   .Lstrange_filament_cache_ptr, r8
    mov     #0, r12               ! filament index
.Lstrange_filament_build_path:
    mov     #0, r11               ! point index 0..12
.Lstrange_filament_build_point:
    ! angle = filament*3277 + frame*80 + point*1536.
    mov.l   .Lstrange_filament_angle_step, r0
    mulu.w  r12, r0
    sts     macl, r0
    mov     r9, r1
    shll8   r1
    shlr2   r1                    ! frame * 64
    add     r1, r0
    mov     r9, r1
    shll2   r1
    shll2   r1                    ! frame * 16
    add     r1, r0
    mov.l   .Lstrange_filament_twist_step, r1
    mulu.w  r11, r1
    sts     macl, r1
    add     r1, r0
    lds     r0, fpul
    fsca    fpul, dr0

    lds     r11, fpul
    float   fpul, fr2
    mov.l   .Lstrange_filament_inv_points, r0
    fmov.s  @r0, fr3
    fmul    fr3, fr2              ! t = point / 12
    mov.l   .Lstrange_filament_span, r0
    fmov.s  @r0, fr3
    fmul    fr2, fr3
    mov.l   .Lstrange_filament_radius, r0
    fmov.s  @r0, fr4
    fadd    fr4, fr3              ! radial distance

    fmov    fr1, fr7
    fmul    fr3, fr7
    fmov    fr0, fr8
    fmul    fr3, fr8
    mov.l   .Lstrange_filament_y_scale, r0
    fmov.s  @r0, fr4
    fmul    fr4, fr8
    mov.l   .Lstrange_filament_half, r0
    fmov.s  @r0, fr4
    fsub    fr4, fr2
    mov.l   .Lstrange_filament_z_span, r0

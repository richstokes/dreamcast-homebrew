+       copied descriptor and event bits survive releasing the socket locks;
+       never dereference s here, since cleanup may already have freed it. */
+    if(poll_ev)
+        __poll_event_trigger(poll_fd, poll_ev);
 
     /* If we get in here, something went wrong... Send a RST. */
     if(rv && !(flags & TCP_FLAG_RST)) {

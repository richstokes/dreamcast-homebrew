diff --git a/kernel/net/net_tcp.c b/kernel/net/net_tcp.c
--- a/kernel/net/net_tcp.c
+++ b/kernel/net/net_tcp.c
@@ -2974,6 +2974,8 @@
     struct tcp_sock *s;
     int rv = -1;
     uint16_t c;
+    short poll_ev = 0;
+    file_t poll_fd = -1;
 
     switch(domain) {
         case AF_INET:
@@ -3052,19 +3054,22 @@
                 break;
         }
 
-        short poll_ev = s->poll_pending;
-        file_t poll_fd = s->sock;
+        poll_ev = s->poll_pending;
+        poll_fd = s->sock;
         s->poll_pending = 0;
 
         mutex_unlock(&s->mutex);
-
-        /* Fire poll wakeups after releasing sock->mutex to avoid the

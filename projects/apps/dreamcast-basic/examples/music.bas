10 REM MUSIC - the PLAY statement and its music macro language
20 CLS : COLOR 14: PRINT "DREAMCAST BASIC JUKEBOX": COLOR 7: PRINT
30 PRINT "1. Ode to Joy (Beethoven)"
40 PRINT "2. Minuet in G (Petzold)"
50 PRINT "3. Twinkle, Twinkle, Little Star"
60 PRINT "4. SOUND sweep and BEEP"
70 PRINT "5. Quit": PRINT
80 INPUT "Your choice"; C
90 IF C < 1 OR C > 5 THEN 80
100 IF C = 5 THEN END
110 ON C GOSUB 200, 300, 400, 500
120 PRINT : GOTO 80
200 PRINT "Ode to Joy..."
210 PLAY "T140 O3 L4 EEFG GFED CCDE E.D8D2"
220 PLAY "EEFG GFED CCDE D.C8C2"
230 PLAY "DDEC DE8F8EC DE8F8ED CD<G2>"
240 PLAY "EEFG GFED CCDE D.C8C2"
250 RETURN
300 PRINT "Minuet in G..."
310 PLAY "T150 O4 L4 D L8 <GAB>C L4 D <G G> E L8 CDEF# L4 G <G G>"
320 PLAY "C L8 DC<BA L4 B L8 >C<BAG L4 F# L8 GAB G L4 B A2"
330 RETURN
400 PRINT "Twinkle, Twinkle..."
410 PLAY "T120 O3 L4 CCGG AAG2 FFEE DDC2"
420 PLAY "GGFF EED2 GGFF EED2"
430 PLAY "CCGG AAG2 FFEE DDC2"
440 RETURN
500 PRINT "Sweep..."
510 FOR F = 200 TO 2000 STEP 100: SOUND F, 1: NEXT F
520 FOR F = 2000 TO 200 STEP -100: SOUND F, 1: NEXT F
530 BEEP
540 RETURN

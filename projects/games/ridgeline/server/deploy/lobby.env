# Ridgeline server settings (/etc/ridgeline/lobby.env). deploy.sh only
# installs this file the first time, so edits on the host survive deploys.
RIDGELINE_LISTEN=:7536
# Bad word list downloaded when the server starts (one word per line; names
# that trip it are refused) and extra words on top of it, comma-separated.
# Defaults: LDNOOBW's English list and none.
#RIDGELINE_BAD_WORDS_URL=https://raw.githubusercontent.com/LDNOOBW/List-of-Dirty-Naughty-Obscene-and-Otherwise-Bad-Words/master/en
#RIDGELINE_BAD_WORDS_EXTRA=

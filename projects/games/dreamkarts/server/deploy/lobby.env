# DreamKarts lobby server settings (/etc/dreamkarts/lobby.env). deploy.sh only
# installs this file the first time, so edits on the host survive deploys.
DREAMKARTS_LISTEN=:7535
# Lobby (1-10) where six bots race recorded races forever; 0 turns it off.
DREAMKARTS_DEMO_LOBBY=10
# Bad word list downloaded when the server starts (one word per line) and
# extra words to filter on top of it, comma-separated. Defaults: LDNOOBW's
# English list and none.
#DREAMKARTS_BAD_WORDS_URL=https://raw.githubusercontent.com/LDNOOBW/List-of-Dirty-Naughty-Obscene-and-Otherwise-Bad-Words/master/en
#DREAMKARTS_BAD_WORDS_EXTRA=

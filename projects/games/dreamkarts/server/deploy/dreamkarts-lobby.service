# DreamKarts online lobby server. Installed by deploy.sh in this directory;
# registered in richstokes/infra servers/netsplit.vip/applications.json.
[Unit]
Description=DreamKarts online lobby server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dreamkarts
Group=dreamkarts
EnvironmentFile=/etc/dreamkarts/lobby.env
# Discord webhooks and Bark keys for lobby alerts, installed
# (root:dreamkarts 0640) by richstokes/infra since they are secret.
# Missing: no alerts.
Environment=DREAMKARTS_ALERTS_CONFIG=/etc/dreamkarts/alerts.json
# Keeps the last downloaded bad word list (STATE_DIRECTORY, writable under
# ProtectSystem=strict) for restarts while its host is unreachable.
StateDirectory=dreamkarts
ExecStart=/opt/dreamkarts/bin/dreamkarts-lobby
Restart=always
RestartSec=3
TimeoutStopSec=10
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=

LimitNOFILE=4096
MemoryMax=64M

[Install]
WantedBy=multi-user.target
